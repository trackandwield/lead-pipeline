# Copy to .env and fill in. .env is git-ignored; never commit real values.

# HubSpot developer test account, private (legacy) app
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Salesforce Developer Edition, External Client App "Lead Pipeline"
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_DOMAIN=https://yourdomain.my.salesforce.com

# Claude, for the LLM part of scoring and the context agent
ANTHROPIC_API_KEY=

# Slack incoming webhooks
SLACK_WEBHOOK_LEAD_ALERTS=
SLACK_WEBHOOK_PIPELINE_HEALTH=
