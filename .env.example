# Copy to .env and fill in. .env is git-ignored; never commit real values.

# HubSpot developer test account, service key (Development > Keys > Service keys)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Salesforce Developer Edition, External Client App "Lead Pipeline"
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_DOMAIN=https://yourdomain.my.salesforce.com

# Claude, for the LLM part of scoring and the context agent
ANTHROPIC_API_KEY=

# Slack incoming webhooks
SLACK_WEBHOOK_LEAD_ALERTS=
SLACK_WEBHOOK_PIPELINE_HEALTH=

# Customer ledger (Postgres from docker-compose.yml)
LEDGER_DATABASE_URL=postgresql://ledger:ledger@localhost:5433/ledger
LEDGER_URL=http://127.0.0.1:8800
# Any long random string. Salts the digests of personal data in the hash chain.
LEDGER_PII_SALT=
